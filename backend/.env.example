PORT=4000
NODE_ENV=development

# MongoDB replica set connection string
MONGO_URI=mongodb://127.0.0.1:27017/ndr?replicaSet=rs0

# Redis (BullMQ only — no correctness dependency)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Meta WhatsApp Cloud API
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# Encryption (field-level for PII)
ENCRYPTION_KEY=

# Google Drive / Gmail (manifest delivery)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_DRIVE_FOLDER_ID=
